        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    USER {\n        UUID id PK\n        string name\n        string email\n        string passwordHash\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    BUSINESS {\n        UUID id PK\n        string name\n        string description\n        string email\n        string phone\n        string timezone\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    BUSINESS_MEMBER {\n        UUID id PK\n        UUID userId FK\n        UUID businessId FK\n        string role \&quot;OWNER | ADMIN | STAFF\&quot;\n        datetime joinedAt\n    }\n\n    SERVICE {\n        UUID id PK\n        UUID businessId FK\n        string name\n        string description\n        int durationMinutes\n        decimal price\n        boolean isActive\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    SERVICE_MEMBER {\n        UUID serviceId PK, FK\n        UUID businessMemberId PK, FK\n    }\n\n    CUSTOMER {\n        UUID id PK\n        UUID businessId FK\n        UUID userId FK \&quot;nullable for guests\&quot;\n        string name\n        string email\n        string phone\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    AVAILABILITY {\n        UUID id PK\n        UUID businessMemberId FK\n        string type \&quot;WEEKLY | EXCEPTION\&quot;\n        int dayOfWeek \&quot;nullable for exceptions\&quot;\n        date specificDate \&quot;nullable for weekly rules\&quot;\n        time startTime\n        time endTime\n        boolean isAvailable\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    APPOINTMENT {\n        UUID id PK\n        UUID businessId FK\n        UUID customerId FK\n        UUID serviceId FK\n        UUID staffMemberId FK\n        datetime startAt\n        datetime endAt\n        string status \&quot;PENDING | CONFIRMED | CANCELLED | COMPLETED\&quot;\n        string notes\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    USER ||--o{ BUSINESS_MEMBER : joins\n    BUSINESS ||--o{ BUSINESS_MEMBER : has_members\n\n    BUSINESS ||--o{ SERVICE : offers\n    BUSINESS_MEMBER ||--o{ SERVICE_MEMBER : provides\n    SERVICE ||--o{ SERVICE_MEMBER : assigned_to\n\n    BUSINESS ||--o{ CUSTOMER : serves\n    USER o|--o{ CUSTOMER : optionally_links\n\n    BUSINESS_MEMBER ||--o{ AVAILABILITY : configures\n\n    BUSINESS ||--o{ APPOINTMENT : owns\n    CUSTOMER ||--o{ APPOINTMENT : books\n    SERVICE ||--o{ APPOINTMENT : requested_for\n    BUSINESS_MEMBER ||--o{ APPOINTMENT : attends\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tY2lA5rwjkU7MumMzkW4-1">
